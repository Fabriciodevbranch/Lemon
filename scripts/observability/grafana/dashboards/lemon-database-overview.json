{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    { "title": "API dashboard", "type": "link", "url": "/d/lemon-api-overview", "keepTime": true },
    { "title": "Containers", "type": "link", "url": "/d/lemon-infrastructure-overview", "keepTime": true }
  ],
  "panels": [
    {
      "type": "stat", "title": "PostgreSQL", "id": 1, "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(pg_up{job=\"postgres\"})", "legendFormat": "PostgreSQL" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] } } }
    },
    {
      "type": "stat", "title": "Connections", "id": 2, "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pg_stat_database_numbackends{job=\"postgres\",datname=\"lemondb\"}", "legendFormat": "active" }]
    },
    {
      "type": "stat", "title": "Database size", "id": 3, "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pg_database_size_bytes{job=\"postgres\",datname=\"lemondb\"}", "legendFormat": "lemondb" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat", "title": "Cache hit ratio", "id": 4, "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"lemondb\"}[5m]) / clamp_min(rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"lemondb\"}[5m]) + rate(pg_stat_database_blks_read{job=\"postgres\",datname=\"lemondb\"}[5m]), 0.001)", "legendFormat": "hit ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.98 }] } } }
    },
    {
      "type": "timeseries", "title": "Transactions", "id": 5, "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\",datname=\"lemondb\"}[5m])", "legendFormat": "commits/s" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\",datname=\"lemondb\"}[5m])", "legendFormat": "rollbacks/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
    },
    {
      "type": "timeseries", "title": "Rows changed", "id": 6, "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_tup_inserted{job=\"postgres\",datname=\"lemondb\"}[5m])", "legendFormat": "inserted/s" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_tup_updated{job=\"postgres\",datname=\"lemondb\"}[5m])", "legendFormat": "updated/s" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_tup_deleted{job=\"postgres\",datname=\"lemondb\"}[5m])", "legendFormat": "deleted/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "rows/s", "min": 0 } }
    },
    {
      "type": "timeseries", "title": "Rows read", "id": 7, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_tup_fetched{job=\"postgres\",datname=\"lemondb\"}[5m])", "legendFormat": "fetched/s" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(pg_stat_database_tup_returned{job=\"postgres\",datname=\"lemondb\"}[5m])", "legendFormat": "returned/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "rows/s", "min": 0 } }
    },
    {
      "type": "table", "title": "Largest application tables", "id": 8, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "postgres" },
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT relname AS table_name, n_live_tup AS estimated_rows, pg_total_relation_size(relid) AS total_bytes, pg_size_pretty(pg_total_relation_size(relid)) AS total_size FROM pg_stat_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 10;",
        "refId": "A"
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["lemon-writer", "postgresql", "database"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Lemon Writer Database",
  "uid": "lemon-database-overview",
  "version": 1
}
